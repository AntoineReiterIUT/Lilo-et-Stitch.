<Window x:Class="Lilo_et_Stitch.View.TranformerViews.WindowAddPattern"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View.TranformerViews"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Publication" Height="250" Width="350">
    <Viewbox>
        <Grid Height="150" Width="230">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>

            </Grid.RowDefinitions>
            <Label Content="Nom du patron :" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="0" FontFamily="Arial"/>
            <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Center" Name="PatternName" />

            <Button Style="{StaticResource TrsfrmAppButton}" Grid.Row="2" Grid.Column="1" Content="Valider" Background="#9b572a" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="61" Click="AjouterButton_Click"/>
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Foreground="Red" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Name="ReturnMessage" VerticalAlignment="Bottom"/>



        </Grid>
    </Viewbox>

</Window>
