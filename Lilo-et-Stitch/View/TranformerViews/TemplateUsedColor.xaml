<UserControl x:Class="Lilo_et_Stitch.View.TemplateUsedColorColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lilo_et_Stitch.View"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="180">

    <Grid>
        <Canvas Width="150" Height="80" x:Name="colorDisplay" Background="Red" Margin="45,0,30,0" />
        <TextBox x:Name="colorDmc" Text="Code_DMC" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Width="44" Height="26" HorizontalContentAlignment="Right" BorderThickness="0" />
        <Rectangle HorizontalAlignment="Left" Stroke="Gray" Width="1"/>
    </Grid>
</UserControl>
