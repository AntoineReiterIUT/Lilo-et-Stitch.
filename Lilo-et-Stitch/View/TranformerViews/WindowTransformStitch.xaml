<Window x:Class="Lilo_et_Stitch.View.WindowTransformStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View"
        WindowState="Maximized"
        mc:Ignorable="d"
        Icon="../Images/logo.png"
        Title="Fenêtre de transformation" MinHeight="500" MinWidth="800">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="400*"/>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="68*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.ColumnSpan="11">
            <Menu DockPanel.Dock="Top" Height="51">

                <Image Source="../Images/logo.png" Mouse.MouseDown="MenuItem_Click"/>

                <MenuItem Header="_Fichier" Height="50" Width="77" FontSize="20" >
                    <MenuItem Header="_Menu principal" Click="MenuItem_Click" >
                        <MenuItem.Icon>
                            <Image Source="../Images/homeIcon.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Changer la palette" Click="ChangePalette_Click"/>
                    <MenuItem Header="_Réinitialiser la palette" Click="ResetPalette_Click" />
                    <Separator />
                    <MenuItem Header="_Quitter" Click="Exit_Click" >
                        <MenuItem.Icon>
                            <Image Source="../Images/exit.png"  />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Viewbox Stretch="UniformToFill" Grid.Row="3" Grid.ColumnSpan="11" Grid.RowSpan="5">
            <Rectangle Stroke="LightGray" StrokeThickness="1"/>
        </Viewbox>
        <Viewbox Stretch="Uniform" Grid.Column="2" Grid.Row="4" VerticalAlignment="Bottom">
            <Grid Width="140" Height="30">
                <Button Content="Insérer une image"  Click="SelectionnerIMG_Click"  Style="{StaticResource TrsfrmAppButton}"/>
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" Grid.Column="4" Grid.Row="3" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="15,0,15,0">
            <Grid Width="100" Height="50">
                <Button Margin="6" Name="TransformBtn" Background="#9b572a" Content="Transformer"  Click="TransformBtn_Click_1" Style="{StaticResource TrsfrmAppButton}"/>
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" Grid.Column="7" Grid.Row="4" HorizontalAlignment="Right">
            <Grid Width="100" Height="50">
                <Button Name="SaveBtn" Content="Sauvegarder" Margin="0,15,0,0" Style="{StaticResource TrsfrmAppButton}" Click="SaveBtn_Click"/>
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" Grid.Column="8" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <Grid Width="100" Height="50">
                <Button Name="PublishBtn" Click="PublishBtn_Click" Content="Publier" Margin="0,15,0,0" Style="{StaticResource TrsfrmAppButton}"/>
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" Grid.Column="2" Grid.Row="3">
            <Grid>
                <TextBox Name="NbStepText" TextWrapping="Wrap" Text="4" VerticalAlignment="Top" Width="30" RenderTransformOrigin="-0.297,0.271" Margin="74,34,4,0" KeyUp="OnTextBoxKeyUpStep" />
                <Slider Name="NbStepSlider" TickFrequency="1"  Minimum="4" Maximum="35" ValueChanged="changeStepValueChanged" IsSnapToTickEnabled="True" Margin="10,10,15,40" Background="#9b572a" Height="15" Foreground="White" Style="{StaticResource CustomBrownSlider}"/>
                <Label Name="NbStepTitle" Content="Taille cases :" Margin="11,28,44,12" />
            </Grid>
        </Viewbox>

        <Viewbox Stretch="Uniform" Grid.Column="3" Grid.Row="3">
            <Grid>
                <TextBox TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="30" Name="NumberOfColors" RenderTransformOrigin="-0.297,0.271" Margin="77,34,15,0" KeyUp="OnTextBoxKeyUpColor"/>
                <Slider Name="NbColorsSlider" TickFrequency="1" Minimum="2" ValueChanged="MaxColorNumberChanged" IsSnapToTickEnabled="True" Margin="10,10,15,40" Background="#9b572a" Height="15" Foreground="White" Style="{StaticResource CustomBrownSlider}" />
                <Label Name="NbColorsTitle" Content="Couleurs :" Margin="15,28,40,12" />
            </Grid>
        </Viewbox>

        <Canvas Grid.Column="7" Grid.ColumnSpan="3" Grid.Row="3" Margin="0,10,0,0" Background="Gray" ></Canvas>
        <ScrollViewer Grid.Column="7" Grid.ColumnSpan="3" Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="1,11,1,1" Background="White">
            <StackPanel x:Name="usedColorList" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>

        <Viewbox Grid.Row="2" Grid.ColumnSpan="11" VerticalAlignment="Bottom">
            <Line HorizontalAlignment="Center" X1="1000" Y1="0" X2="0" Y2="0" Stroke="Black" StrokeThickness="1"/>
        </Viewbox>

        <Image Grid.Column="7" Grid.ColumnSpan="2" Grid.Row="1" Name="NewImg"/>
        <Image Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Name="imagePrev"/>

        <Viewbox Stretch="Uniform" Grid.Column="3" Grid.Row="4">
            <Grid Width="142" VerticalAlignment="Bottom" Height="66">
                <Rectangle Fill="Black" Margin="9,49,13,0"/>
                <Canvas Name="gridColorCanva" Background="Black"  Margin="10,50,14,1"/>
                <Button Name="gridColorBtn" Content="Couleur grille" Click="change_grid_color" Width="118" Margin="10,15,14,22" Style="{StaticResource TrsfrmAppButton}"/>
            </Grid>

        </Viewbox>
    </Grid>
</Window>
