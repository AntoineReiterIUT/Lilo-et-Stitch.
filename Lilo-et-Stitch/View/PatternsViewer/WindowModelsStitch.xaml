<Window x:Class="Lilo_et_Stitch.View.PatternsViewer.WindowModelsStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:patterns="clr-namespace:Lilo_et_Stitch.View.PatternsViewer"        
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        mc:Ignorable="d"
        Icon="../Images/logo.png"
        Title="StitchModels" Height="450" Width="800">
    <Viewbox Stretch="Fill">
        <Grid Height="460" Width="880">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="21*"/>
                <RowDefinition Height="14*"/>
                <RowDefinition Height="87*"/>
                <RowDefinition Height="82*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top" Grid.ColumnSpan="4" Grid.RowSpan="1" Height="35">
                <Menu Height="35">

                    <Image Source="../Images/logo.png" Mouse.MouseDown="MenuItem_Click"/>

                    <MenuItem Header="Menu" FontSize="15" Click="HomeButton_Click" IsHitTestVisible="False"/>
                </Menu>
            </StackPanel>

            <Label FontSize="15" Content="Recherche : " HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="30" Margin="106,0,0,0" Width="89"/>
            <TextBox GotKeyboardFocus="textSearch_GotKeyboardFocus" Keyboard.KeyUp="textSearch_KeyUp" x:Name="textSearch" VerticalContentAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Foreground="Gray" Text="Mon patron..." Grid.ColumnSpan="3" Margin="195,2,293,0" Grid.Row="1"/>

            <ItemsControl Grid.Row="2" x:Name="controlModels" Grid.RowSpan="2" Grid.ColumnSpan="4" Margin="0,2,293,0" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <patterns:TemplateUserModel/>


                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="4" Margin="52,0,0,0" BorderThickness="0" Content="&lt;" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_PreviousClick" Foreground="Black" Height="40"/>
            <Label Foreground="White" Grid.Column="2" Content="&lt;" FontSize="30" HorizontalAlignment="Left" Margin="51,161,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False" Height="42" Width="31" Grid.RowSpan="2"/>

            <Button Style="{StaticResource MenuButton}" Content="«" Width="30" FontSize="30" Grid.Column="2" Grid.Row="4" Margin="12,0,0,0" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_FirstClick" Foreground="Black" Height="40"/>
            <Label Foreground="White" Grid.Column="2" Content="«" FontSize="30" HorizontalAlignment="Left" Margin="12,162,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False" Height="39" Width="31" Grid.RowSpan="2"/>

            <Button Style="{StaticResource MenuButton}" Content="»" Width="30" FontSize="30" Grid.Column="2" Grid.Row="4" Margin="142,0,0,0" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_LastClick" Foreground="Black" Height="40"/>
            <Label Foreground="White" Grid.Column="2" Content="»" FontSize="30" HorizontalAlignment="Left" Margin="142,162,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False" Height="39" Width="31" Grid.RowSpan="2"/>

            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="4" Margin="102,0,0,0" BorderThickness="0" Content=">" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_NextClick" Foreground="Black" Height="40"/>
            <Label Foreground="White" Grid.Column="2" Content=">" FontSize="30" HorizontalAlignment="Left" Margin="102,162,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False" Height="41" Width="31" Grid.RowSpan="2"/>


            <Label FontSize="20" Content="Page : " HorizontalAlignment="Left" Margin="0,14,0,0" Grid.Row="4" VerticalAlignment="Top" Height="36" Width="68"/>
            <TextBox x:Name="textNumPage" FontSize="20" HorizontalAlignment="Left" Margin="63,20,0,0" Grid.Row="4" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="18" KeyDown="textNumPage_KeyDown" Height="28"/>
            <Label x:Name="textMaxPages" Content="/ 1" FontSize="20" HorizontalAlignment="Center" Margin="0,15,0,0" Grid.Row="4" VerticalAlignment="Top" Height="36" Width="34"/>

            <Rectangle Grid.Column="3" Grid.Row="0" HorizontalAlignment="Left" Stretch="UniformToFill" Margin="24,35,0,0" Grid.RowSpan="5" Stroke="Black" VerticalAlignment="Top" Width="1" Height="450"/>
            <Rectangle Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="4" HorizontalAlignment="Left" Stretch="UniformToFill" Margin="0,0,0,0" Stroke="Black" VerticalAlignment="Top" Width="900" Height="1" />
            <Image x:Name="SelectedPattern" Grid.Column="3" Grid.Row="1" Margin="39,3,14,2" Grid.RowSpan="2" />

            <Button Style="{StaticResource TrsfrmAppButton}" x:Name="buttonDownload" Visibility="Collapsed" FontSize="20" Grid.Column="3" Content="Télécharger" HorizontalAlignment="Left" Height="48" Grid.Row="4" VerticalAlignment="Center" Width="205" Margin="56,0,0,0" Click="Button_DownloadClick"/>

            <Viewbox Grid.Column="3" Grid.Row="3" VerticalAlignment="Top" Margin="30,5,5,120" MaxHeight="60">
                <TextBlock TextWrapping="Wrap" x:Name="LabelName" HorizontalAlignment="Left" FontSize="25" VerticalAlignment="Top" Margin="10"/>
            </Viewbox>

            <Label Grid.Column="3" FontSize="15" x:Name="LabelStep" HorizontalAlignment="Left" Margin="39,50,0,0" Grid.Row="3" VerticalAlignment="Top" />
            <Label Grid.Column="3" FontSize="15" x:Name="LabelMaxColors" HorizontalAlignment="Left" Margin="39,80,0,0" Grid.Row="3" VerticalAlignment="Top" />
            <Label Grid.Column="3" FontSize="15" x:Name="LabelColorGrid" HorizontalAlignment="Left" Margin="60,110,0,0" Grid.Row="3" VerticalAlignment="Top" />
            <Rectangle Grid.Column="3" x:Name="RectangleColorGrid" HorizontalAlignment="Left" Margin="39,115,0,0" Grid.Row="3" Height="20" Width="20" VerticalAlignment="Top" />
        </Grid>
    </Viewbox>
</Window>