<Window x:Class="Lilo_et_Stitch.View.WindowModelsStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View" 
        xmlns:patterns="clr-namespace:Lilo_et_Stitch.View.PatternsViewer"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Icon="../Images/logo.png"
        Title="StitchModels" Height="450" Width="800">
    <Viewbox>
        <Grid Height="450" Width="830">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <patterns:TemplateUserModel x:Name="Pattern1" Grid.Column="0" Grid.Row="0"/>
            <patterns:TemplateUserModel x:Name="Pattern2" Grid.Column="01" Grid.Row="0"/>
            <patterns:TemplateUserModel x:Name="Pattern3" Grid.Column="02" Grid.Row="0"/>

            <patterns:TemplateUserModel x:Name="Pattern4" Grid.Column="0" Grid.Row="01"/>
            <patterns:TemplateUserModel x:Name="Pattern5" Grid.Column="01" Grid.Row="01"/>
            <patterns:TemplateUserModel x:Name="Pattern6" Grid.Column="02" Grid.Row="01"/>

            <Button FontSize="30" Grid.Column="2" Grid.Row="3" Margin="0,0,50,0" BorderThickness="0" Content="⏪" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click"/>
            <Button FontSize="30" Grid.Column="2" Grid.Row="3" Margin="50,0,0,0" BorderThickness="0" Content="⏩" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click"/>
        </Grid>
    </Viewbox>
</Window>
