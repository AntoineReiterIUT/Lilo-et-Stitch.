<Window x:Class="Lilo_et_Stitch.View.WindowModelsStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View" 
        xmlns:patterns="clr-namespace:Lilo_et_Stitch.View.PatternsViewer"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Icon="../Images/logo.png"
        Title="StitchModels" Height="450" Width="800">
    <Viewbox>
        <Grid Height="450" Width="830">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <ItemsControl Grid.RowSpan="2" Grid.ColumnSpan="3" ItemsSource="{Binding Patterns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <patterns:TemplateUserModel />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="3" Margin="0,0,50,0" BorderThickness="0" Content="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_PreviousClick" Foreground="Black"/>
            <Label Foreground="White" Grid.Column="2" Content="&lt;" FontSize="30" HorizontalAlignment="Center" Margin="0,0,50,8" Grid.Row="2" VerticalAlignment="Center" IsHitTestVisible="False"/>


            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="3" Margin="50,0,0,0" BorderThickness="0" Content=">" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_NextClick" Foreground="Black"/>
            <Label Foreground="White" Grid.Column="2" Content=">" FontSize="30" HorizontalAlignment="Center" Margin="50,0,0,8" Grid.Row="2" VerticalAlignment="Center" IsHitTestVisible="False"/>

            <Label Grid.Column="1" Content="Page : " HorizontalAlignment="Left" Margin="113,0,0,0" Grid.Row="2" VerticalAlignment="Center"/>
            <TextBlock x:Name="numPage" Grid.Column="1" HorizontalAlignment="Left" Margin="158,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="1" VerticalAlignment="Center" Width="24" Height="15"/>


            <Rectangle Grid.Column="3" HorizontalAlignment="Left" Stretch="UniformToFill" Margin="24,0,0,0" Grid.RowSpan="3" Stroke="Black" VerticalAlignment="Top" Width="1" Height="450"/>
            <patterns:TemplateUserModel x:Name="Pattern1_Copy" Grid.Column="3" Grid.Row="0" Margin="33,10,10,170" Grid.RowSpan="2" />
            
            <Button Style="{StaticResource TrsfrmAppButton}" Grid.Column="3" Content="Télécharger" HorizontalAlignment="Left" Height="41" Margin="60,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="189"/>
        </Grid>
    </Viewbox>
</Window>
