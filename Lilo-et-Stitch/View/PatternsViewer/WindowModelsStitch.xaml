<Window x:Class="Lilo_et_Stitch.View.WindowModelsStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View" 
        xmlns:patterns="clr-namespace:Lilo_et_Stitch.View.PatternsViewer"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Icon="../Images/logo.png"
        Title="StitchModels" Height="450" Width="800">
    <Viewbox>
        <Grid Height="460" Width="880">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="45*"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="top" Grid.ColumnSpan="4" Grid.RowSpan="1">
                <Menu DockPanel.Dock="Top" Height="54">

                    <Image Source="../Images/logo.png" Mouse.MouseDown="MenuItem_Click"/>

                    <MenuItem Header="Menu" Height="38" Width="51" FontSize="15" Click="HomeButton_Click" IsHitTestVisible="False"/>
                </Menu>
            </StackPanel>



            <ItemsControl Grid.Row="1" x:Name="test" Grid.RowSpan="2" Grid.ColumnSpan="3" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <patterns:TemplateUserModel />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="3" Margin="52,0,0,0" BorderThickness="0" Content="&lt;" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_PreviousClick" Foreground="Black"/>
            <Label Foreground="White" Grid.Column="2" Content="&lt;" FontSize="30" HorizontalAlignment="Left" Margin="52,13,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False"/>


            <Button Style="{StaticResource MenuButton}" Width="30" FontSize="30" Grid.Column="2" Grid.Row="3" Margin="102,0,0,0" BorderThickness="0" Content=">" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_NextClick" Foreground="Black"/>
            <Label Foreground="White" Grid.Column="2" Content=">" FontSize="30" HorizontalAlignment="Left" Margin="102,13,0,0" Grid.Row="3" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <Label FontSize="20" Content="Page : " HorizontalAlignment="Left" Margin="10,24,0,0" Grid.Row="3" VerticalAlignment="Top"/>
            <TextBox BorderBrush="Transparent" x:Name="numPage" FontSize="20" HorizontalAlignment="Left" Margin="71,28,0,0" Grid.Row="3" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="36" TextChanged="NumPage_TextChanged" Height="28"/>



            <Rectangle Grid.Column="3" Grid.Row="1" HorizontalAlignment="Left" Stretch="UniformToFill" Margin="24,0,0,0" Grid.RowSpan="4" Stroke="Black" VerticalAlignment="Top" Width="1" Height="450"/>
            <Rectangle Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4" HorizontalAlignment="Left" Stretch="UniformToFill" Margin="0,0,0,0" Stroke="Black" VerticalAlignment="Top" Width="900" Height="1"/>
            <Image x:Name="SelectedPattern" Grid.Column="3" Grid.Row="1" Margin="39,3,14,2" />

            <Button Style="{StaticResource TrsfrmAppButton}" FontSize="20" Grid.Column="3" Content="Télécharger" HorizontalAlignment="Left" Height="49" Grid.Row="3" VerticalAlignment="Center" Width="205" Margin="56,0,0,0" Click="Button_DownloadClick"/>
            <Label Grid.Column="3" x:Name="LabelName" HorizontalAlignment="Left" FontSize="25" Margin="39,20,14,0" Grid.Row="2" VerticalAlignment="Top"/>
            <Label Grid.Column="3" FontSize="15" x:Name="LabelStep" HorizontalAlignment="Left"  Margin="39,60,14,0" Grid.Row="2" VerticalAlignment="Top"/>
            <Label Grid.Column="3" FontSize="15" x:Name="LabelMaxColors" HorizontalAlignment="Left"  Margin="39,80,14,0" Grid.Row="2" VerticalAlignment="Top"/>
            <Label Grid.Column="3" FontSize="15" x:Name="LabelColorGrid" HorizontalAlignment="Left"  Margin="60,110,14,0" Grid.Row="2" VerticalAlignment="Top"/>
            <Rectangle Grid.Column="3" x:Name="RectangleColorGrid" HorizontalAlignment="Left"  Margin="39,115,14,0" Grid.Row="2" Height="20" Width="20" VerticalAlignment="Top"/>
        </Grid>
    </Viewbox>
</Window>