<Window x:Class="Lilo_et_Stitch.View.WindowMenuStitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View"
        WindowStartupLocation="CenterScreen"
        Icon="Images/logo.png"
        mc:Ignorable="d"
        Title="StitchMenu" Height="600" Width="1000" MinHeight="200" MinWidth="350">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        
        <Viewbox Grid.ColumnSpan="5" Grid.RowSpan="3">
            <Image Margin="-389,0,268,-365" Source="Images/logo.png" Opacity="0.197" Height="836" Width="817"/>
        </Viewbox>
        
        <Viewbox Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" Stretch="Uniform">
            <Label Content="Accueil Stitch" FontSize="40" FontFamily="Sylfaen"/>
        </Viewbox>

        <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
            <Button Content="   Nouveau modèle   " Name="NewModel" Click="NewModel_Click" Height="40" BorderThickness="5" Style="{StaticResource MenuButton}"/>
        </Viewbox>

        <Viewbox Grid.Row="1" Grid.Column="3" Stretch="Uniform">
            <Button Content="   Liste des modèles   " Click="ModelServ_Click" Height="41" Style="{StaticResource MenuButton}"/>
        </Viewbox>
        
    </Grid>
</Window>
