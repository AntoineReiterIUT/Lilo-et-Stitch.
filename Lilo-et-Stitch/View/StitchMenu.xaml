<Window x:Class="Lilo_et_Stitch.View.StitchMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lilo_et_Stitch.View"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="StitchMenu" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Viewbox Grid.Column="1" Grid.Row="0" Stretch="Uniform">
            <Label Content="Accueil" FontSize="20" Margin="5"/>
        </Viewbox>

        <Viewbox Grid.Row="0" Grid.Column="2" Stretch="Uniform">
            <Label Content="Stitch"  FontSize="20" Margin="5"/>
        </Viewbox>

        <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
            <Button Content="Nouveau modèle " Name="NewModel" Click="NewModel_Click" Margin="10" Height="100" />
        </Viewbox>


        <Viewbox Grid.Row="1" Grid.Column="2" Stretch="Uniform">
            <Button Content="Liste des modèles"  Click="ModelServ_Click" Margin="10" Height="100"/>
        </Viewbox>

        <Image Margin="50" Source="Images/logo.png"/>




    </Grid>
</Window>
